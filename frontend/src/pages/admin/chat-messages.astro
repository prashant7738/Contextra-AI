---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Chat messages – Admin" requireAuth>
  <main class="u-332af37" id="main">
    <p><a href="/admin">← Back to admin</a></p>
    <h2 id="heading">Messages</h2>
    <div id="loading">Loading messages…</div>
    <ul class="u-18de788" id="messages"></ul>
  </main>

  <script>
    import { apiClient } from '../../utils/api';
    import { escapeHtml } from '../../utils/escapeHtml';

    interface AdminMessage {
      user_id: number;
      user_message: string;
      bot_response: string;
      created_at: string;
    }

    const params = new URLSearchParams(window.location.search);
    const chatId = params.get('id');
    const msgsEl = document.getElementById('messages') as HTMLUListElement | null;
    const loadingEl = document.getElementById('loading') as HTMLElement | null;
    const headingEl = document.getElementById('heading') as HTMLHeadingElement | null;

    if (!chatId) {
      if (loadingEl) loadingEl.style.display = 'none';
      if (msgsEl) {
        msgsEl.innerHTML =
          '<li class="u-6a8d130">Missing chat id in URL (?id=…)</li>';
      }
    } else {
      if (headingEl) headingEl.textContent = `Messages for chat #${chatId}`;
      void load();
    }

    async function load() {
      if (!msgsEl || !loadingEl) return;
      loadingEl.style.display = 'block';
      const res = await apiClient.get<AdminMessage[]>(`/admin/chats/${chatId}/messages`);
      loadingEl.style.display = 'none';
      if (res.error) {
        msgsEl.innerHTML = `<li class="u-6a8d130">${escapeHtml(res.error)}</li>`;
        return;
      }
      const msgs = res.data ?? [];
      if (!msgs.length) {
        msgsEl.innerHTML =
          '<li class="u-2342759">No messages</li>';
        return;
      }
      msgsEl.innerHTML = msgs
        .map(
          (m) => `
        <li class="u-22be495">
          <div class="u-eed0f8f">User: ${m.user_id}</div>
          <div class="u-98fa35d">${escapeHtml(m.user_message)}</div>
          <div class="u-dbfb807">Bot: ${escapeHtml(m.bot_response)}</div>
          <div class="u-b250a2c">${new Date(m.created_at).toLocaleString()}</div>
        </li>`
        )
        .join('');
    }
  </script>
</BaseLayout>
