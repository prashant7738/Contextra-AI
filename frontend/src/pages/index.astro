---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---
<BaseLayout
  title="Contextra AI – Chat with your documents"
  description="Upload your PDFs and notes. Ask questions with cited answers, get 80/20 summaries, and turn anything into flashcards."
>
  <header class="lp-nav">
    <a href="/" class="lp-brand">Contextra<span>AI</span></a>
    <nav class="lp-nav-links" aria-label="Primary">
      <a href="#features">Features</a>
      <a href="#how">How it works</a>
    </nav>
    <div class="lp-nav-actions">
      <ThemeToggle class="theme-toggle-navbar" />
      <a href="/login" class="lp-link" data-auth-hide>Log in</a>
      <a href="/register" class="lp-btn lp-btn-primary" data-auth-hide>Get started free</a>
      <a href="/dashboard" class="lp-btn lp-btn-primary" data-auth-show hidden>Open workspace</a>
    </div>
  </header>

  <main id="main" class="lp">
    <section class="lp-hero">
      <p class="lp-eyebrow">Your documents, supercharged</p>
      <h1>Stop drowning in PDFs.<br />Start <em>talking</em> to them.</h1>
      <p class="lp-sub">
        Upload your notes, papers or textbooks. Contextra AI answers in plain English,
        with citations back to your own files — no guessing, no hallucinations.
      </p>
      <div class="lp-cta">
        <a href="/register" class="lp-btn lp-btn-primary lp-btn-lg" data-auth-hide>Try it free</a>
        <a href="/dashboard" class="lp-btn lp-btn-primary lp-btn-lg" data-auth-show hidden>Open workspace</a>
        <a href="#how" class="lp-btn lp-btn-ghost lp-btn-lg">See how it works</a>
      </div>
      <p class="lp-note">Works with any PDF · Takes under a minute</p>

      <div class="lp-demo" aria-hidden="true">
        <div class="lp-demo-bar"><i></i><i></i><i></i><span>Biology — Semester 2</span></div>
        <div class="lp-demo-body">
          <div class="lp-msg lp-msg-user">What are the key differences between mitosis and meiosis?</div>
          <div class="lp-msg lp-msg-bot">
            Mitosis produces two identical diploid cells for growth and repair, while meiosis
            produces four genetically distinct haploid cells for reproduction.
            <div class="lp-cites"><span>lecture-04.pdf · p.12</span><span>notes.pdf · p.3</span></div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="lp-section">
      <h2>Everything you need to actually learn it</h2>
      <div class="lp-grid">
        <article class="lp-card">
          <div class="lp-ico">💬</div>
          <h3>Chat with citations</h3>
          <p>Ask anything. Every answer links back to the exact passage in your source.</p>
        </article>
        <article class="lp-card">
          <div class="lp-ico">⚡</div>
          <h3>80/20 Pareto summaries</h3>
          <p>Get the 20% of content that carries 80% of the value, plus a revision checklist.</p>
        </article>
        <article class="lp-card">
          <div class="lp-ico">🗂️</div>
          <h3>Instant flashcards</h3>
          <p>Turn any document set into a smart deck with explanations and sources.</p>
        </article>
        <article class="lp-card">
          <div class="lp-ico">📚</div>
          <h3>Separate workspaces</h3>
          <p>Keep every course or project in its own chat with its own documents.</p>
        </article>
      </div>
    </section>

    <section id="how" class="lp-section">
      <h2>From upload to understanding in three steps</h2>
      <ol class="lp-steps">
        <li><b>1</b><div><h3>Upload</h3><p>Drop in your PDFs. Scanned pages are read with OCR.</p></div></li>
        <li><b>2</b><div><h3>Ask</h3><p>Chat, summarize a topic, or generate flashcards.</p></div></li>
        <li><b>3</b><div><h3>Remember</h3><p>Review with sourced answers and decks you can trust.</p></div></li>
      </ol>
    </section>

    <section class="lp-final">
      <h2>Your second brain is one upload away.</h2>
      <a href="/register" class="lp-btn lp-btn-primary lp-btn-lg" data-auth-hide>Create your free account</a>
      <a href="/dashboard" class="lp-btn lp-btn-primary lp-btn-lg" data-auth-show hidden>Open workspace</a>
    </section>
  </main>

  <footer class="lp-footer">
    <span>© Contextra AI</span>
    <span><a href="/login">Log in</a> · <a href="/register">Sign up</a></span>
  </footer>

  <script>
    // Bundled (not is:inline) so it is covered by the Content-Security-Policy.
    let authed = false;
    try {
      authed = !!localStorage.getItem('access_token');
    } catch {
      /* storage unavailable */
    }
    if (authed) {
      document.querySelectorAll<HTMLElement>('[data-auth-hide]').forEach((el) => (el.hidden = true));
      document.querySelectorAll<HTMLElement>('[data-auth-show]').forEach((el) => (el.hidden = false));
    }
  </script>
</BaseLayout>

<style is:global>
  .lp-nav {
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; gap: var(--space-5);
    padding: var(--space-3) clamp(16px, 5vw, 56px);
    background: var(--color-surface-overlay);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .lp-brand {
    font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl);
    color: var(--color-text); text-decoration: none; letter-spacing: -0.02em;
  }
  .lp-brand span { color: var(--color-accent); margin-left: 4px; }
  .lp-nav-links { display: flex; gap: var(--space-5); margin-left: var(--space-5); }
  .lp-nav-links a, .lp-link {
    color: var(--color-text-muted); text-decoration: none; font-size: var(--text-sm); font-weight: 500;
  }
  .lp-nav-links a:hover, .lp-link:hover { color: var(--color-text); }
  .lp-nav-actions { margin-left: auto; display: flex; align-items: center; gap: var(--space-4); }
  .lp [hidden], .lp-nav [hidden], .lp-final [hidden] { display: none !important; }

  .lp-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 10px 18px; border-radius: var(--radius-full);
    font-size: var(--text-sm); font-weight: 600; text-decoration: none;
    border: 1px solid transparent; cursor: pointer;
    transition: transform var(--duration-2) var(--ease-standard),
                background var(--duration-2) var(--ease-standard);
  }
  .lp-btn:hover { transform: translateY(-1px); }
  .lp-btn:focus-visible { outline: 2px solid var(--color-focus-ring); outline-offset: 2px; }
  .lp-btn-primary { background: var(--color-accent); color: var(--color-accent-fg); box-shadow: var(--shadow-2); }
  .lp-btn-primary:hover { background: var(--color-accent-hover); }
  .lp-btn-ghost { background: transparent; color: var(--color-text); border-color: var(--color-border-strong); }
  .lp-btn-lg { padding: 14px 26px; font-size: var(--text-base); }

  .lp { padding: 0 clamp(16px, 5vw, 56px); }
  .lp-hero {
    max-width: 920px; margin: 0 auto; text-align: center;
    padding: clamp(48px, 9vw, 112px) 0 var(--space-9);
  }
  .lp-eyebrow {
    display: inline-block; margin: 0 0 var(--space-4); padding: 6px 14px;
    border-radius: var(--radius-full); background: var(--color-accent-soft);
    color: var(--color-accent); font-size: var(--text-xs); font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
  }
  .lp-hero h1 {
    margin: 0 0 var(--space-5); font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.6rem + 4.2vw, 4.6rem); line-height: 1.05; letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .lp-hero h1 em { font-style: italic; color: var(--color-accent); }
  .lp-sub {
    max-width: 640px; margin: 0 auto var(--space-7);
    font-size: var(--text-lg); line-height: var(--leading-relaxed); color: var(--color-text-muted);
  }
  .lp-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); justify-content: center; }
  .lp-note { margin: var(--space-4) 0 0; font-size: var(--text-xs); color: var(--color-text-muted); }

  .lp-demo {
    max-width: 700px; margin: var(--space-9) auto 0; text-align: left;
    background: var(--color-surface-strong); border: 1px solid var(--color-border);
    border-radius: var(--radius-xl); box-shadow: var(--shadow-4); overflow: hidden;
  }
  .lp-demo-bar {
    display: flex; align-items: center; gap: 6px; padding: 12px 16px;
    border-bottom: 1px solid var(--color-border); background: var(--color-bg-soft);
  }
  .lp-demo-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--color-border-strong); }
  .lp-demo-bar span { margin-left: 10px; font-size: var(--text-xs); color: var(--color-text-muted); }
  .lp-demo-body { display: grid; gap: var(--space-3); padding: var(--space-5); }
  .lp-msg { padding: 12px 16px; border-radius: var(--radius-lg); font-size: var(--text-sm); line-height: var(--leading-normal); max-width: 88%; }
  .lp-msg-user { justify-self: end; background: var(--color-accent); color: var(--color-accent-fg); }
  .lp-msg-bot { background: var(--color-bg-soft); border: 1px solid var(--color-border); color: var(--color-text); }
  .lp-cites { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .lp-cites span {
    padding: 3px 10px; border-radius: var(--radius-full); font-size: var(--text-xs);
    background: var(--color-accent-soft); color: var(--color-accent);
  }

  .lp-section { max-width: 1080px; margin: 0 auto; padding: var(--space-10) 0 var(--space-6); }
  .lp-section h2, .lp-final h2 {
    margin: 0 0 var(--space-7); text-align: center; font-family: var(--font-display);
    font-size: var(--text-3xl); letter-spacing: -0.02em; color: var(--color-text);
  }
  .lp-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .lp-card {
    padding: var(--space-6); background: var(--color-surface-strong);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    transition: transform var(--duration-3) var(--ease-standard), box-shadow var(--duration-3) var(--ease-standard);
  }
  .lp-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-3); }
  .lp-ico { font-size: 1.6rem; margin-bottom: var(--space-3); }
  .lp-card h3, .lp-steps h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); color: var(--color-text); }
  .lp-card p, .lp-steps p { margin: 0; font-size: var(--text-sm); line-height: var(--leading-normal); color: var(--color-text-muted); }

  .lp-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .lp-steps li { display: flex; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .lp-steps b {
    flex: none; width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: 50%; background: var(--color-accent); color: var(--color-accent-fg); font-weight: 700;
  }

  .lp-final {
    max-width: 1080px; margin: var(--space-10) auto; padding: var(--space-9) var(--space-5);
    text-align: center; border-radius: var(--radius-2xl);
    background: radial-gradient(800px 300px at 50% 0%, var(--color-accent-soft), transparent 70%), var(--color-surface-strong);
    border: 1px solid var(--color-border);
  }
  .lp-footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3);
    padding: var(--space-6) clamp(16px, 5vw, 56px); border-top: 1px solid var(--color-border);
    font-size: var(--text-xs); color: var(--color-text-muted);
  }
  .lp-footer a { color: inherit; }

  @media (max-width: 640px) {
    .lp-nav-links, .lp-link { display: none; }
    .lp-nav-actions { gap: var(--space-2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-btn, .lp-card { transition: none; }
    .lp-btn:hover, .lp-card:hover { transform: none; }
  }
</style>
