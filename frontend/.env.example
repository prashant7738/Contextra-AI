# Backend base URL (no trailing slash)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# PUBLIC_API_BASE_URL=https://contextra-ai.onrender.com

# "presign" uploads straight to Supabase Storage (requires backend SUPABASE_* vars);
# anything else uses direct multipart upload to the backend.
PUBLIC_UPLOAD_METHOD=presign
