# ---------------------------------------------------------------------------
# Contextra AI backend environment variables.
# Locally: copy to .env. On Render: add each one under Environment.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# PostgreSQL with the pgvector extension. On Supabase use the "Session pooler"
# connection string (Project Settings -> Database -> Connection string).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# OpenAI key (https://platform.openai.com/api-keys). Used for gpt-6-luna and text-embedding-3-small.
OPENAI_API_KEY=sk-...

# JWT signing secret, at least 32 random characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Email of the admin account (unlocks /admin endpoints)
ADMIN_EMAIL=you@example.com

# Shared secret for the /cron endpoint (use any long random string)
CRON_SECRET=

# --- Spend cap --------------------------------------------------------------

# Global OpenAI spend cap per UTC day, in USD, shared by all users
DAILY_BUDGET_USD=0.25

# --- Auth tuning (defaults shown) -------------------------------------------

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Monthly OpenAI spend cap (USD) for new users; admins can change it per user
DEFAULT_USER_BUDGET_USD=1.0

# --- Frontend / CORS --------------------------------------------------------

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://contextra-ai.vercel.app

# --- Supabase Storage (optional, leave empty for direct upload) -------------

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# --- Render only ------------------------------------------------------------

# PYTHON_VERSION=3.12.0

# --- Logging ---------------------------------------------------------------

# DEBUG, INFO (default), WARNING, ERROR
LOG_LEVEL=INFO

# --- Background jobs (PDF ingestion, summaries) ------------------------------

# Worker threads per process that claim jobs from the database (0 disables).
JOB_WORKERS=2
# Attempts before a job interrupted by restarts is marked failed.
# JOB_MAX_ATTEMPTS=3
# A running job whose heartbeat is older than this many seconds is retried.
# JOB_STALE_SECONDS=120
